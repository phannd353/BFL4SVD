{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": ".",
  "entryFile": "src/main",
  "compilerOptions": {
    "assets": [
      {
        "include": "./prisma/generated/**/*",
        "watchAssets": true
      },
      {
        "include": "./artifacts/**/*",
        "watchAssets": true
      }
    ],
    "deleteOutDir": true
  }
}
