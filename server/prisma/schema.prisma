generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    String?
  banned                  Boolean?                 @default(false)
  banReason               String?
  banExpires              DateTime?
  sessions                Session[]
  accounts                Account[]
  trainingJobs            TrainingJob[]            @relation("TrainingJobCreator")
  trainingJobParticipants TrainingJobParticipant[]

  walletAddress String?

  @@unique([email])
  @@unique([walletAddress])
  @@map("user")
}

enum TrainingJobStatus {
  DRAFT
  WAITING
  RUNNING
  STOPPED
  COMPLETED
  CANCELLED
  FAILED
}

enum TrainingJobParticipantStatus {
  JOINED
  LEFT
}

enum TrainingRoundStatus {
  RUNNING
  STOPPED
  COMPLETED
}

enum ChainSyncStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model Model {
  hash            String          @id
  size            Int
  filePath        String
  chainTxHash     String?
  chainSyncStatus ChainSyncStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  TrainingJobAsInitialModel         TrainingJob[]      @relation("InitialModel")
  TrainingJobAsFinalModel           TrainingJob[]      @relation("FinalModel")
  TrainingJobRoundAsPrevModel       TrainingJobRound[] @relation("PreviousModel")
  TrainingJobRoundAsAggregatedModel TrainingJobRound[] @relation("AggregatedModel")
  ModelUpdateAsPrevModel            ModelUpdate[]      @relation("PreviousModelUpdate")

  @@map("model")
}

model TrainingJob {
  id                     String                   @id @default(cuid())
  chainJobId             BigInt?                  @unique
  chainTxHash            String?
  chainSyncStatus        ChainSyncStatus          @default(PENDING)
  name                   String
  description            String?
  status                 TrainingJobStatus        @default(DRAFT)
  createdById            String?
  createdBy              User?                    @relation("TrainingJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  initialModelHash       String
  finalModelHash         String?
  initialModel           Model                    @relation("InitialModel", fields: [initialModelHash], references: [hash], onDelete: SetNull)
  finalModel             Model?                   @relation("FinalModel", fields: [finalModelHash], references: [hash], onDelete: SetNull)
  plannedRounds          Int                      @default(30)
  currentRound           Int                      @default(0)
  epochs                 Int                      @default(10)
  batchSize              Int                      @default(32)
  learningRate           Float                    @default(0.001)
  publishAt              DateTime                 @default(now())
  publishedAt            DateTime?
  startAt                DateTime?
  startedAt              DateTime?
  stoppingReason         String?
  failureReason          String?
  participants           TrainingJobParticipant[]
  rounds                 TrainingJobRound[]
  logs                   TrainingJobLog[]
  blockchainTransactions BlockchainTransaction[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([publishAt, publishedAt])
  @@index([startAt, status])
  @@map("training_job")
}

model TrainingJobParticipant {
  id       String                       @id @default(cuid())
  jobId    String
  job      TrainingJob                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId   String
  user     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   TrainingJobParticipantStatus @default(JOINED)
  joinedAt DateTime                     @default(now())
  leftAt   DateTime?

  @@unique([jobId, userId])
  @@index([userId, status])
  @@map("training_job_participant")
}

model TrainingJobRound {
  id                     String                  @id @default(cuid())
  chainTxHash            String?
  chainSyncStatus        ChainSyncStatus         @default(PENDING)
  jobId                  String
  job                    TrainingJob             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  prevModelHash          String
  aggregatedModelHash    String?
  prevModel              Model                   @relation("PreviousModel", fields: [prevModelHash], references: [hash], onDelete: SetNull)
  aggregatedModel        Model?                  @relation("AggregatedModel", fields: [aggregatedModelHash], references: [hash], onDelete: SetNull)
  roundNumber            Int
  status                 TrainingRoundStatus     @default(RUNNING)
  metrics                Json?
  /// Result of evaluating `aggregatedModelHash` on the participants' test data
  /// (aggregated by Flower). Written once, after the round completes.
  evaluation             Json?
  evaluatedAt            DateTime?
  startedAt              DateTime                @default(now())
  completedAt            DateTime?
  createdAt              DateTime                @default(now())
  modelUpdates           ModelUpdate[]
  blockchainTransactions BlockchainTransaction[]

  @@unique([jobId, roundNumber])
  @@map("training_job_round")
}

model BlockchainTransaction {
  txHash        String            @id
  /// Actual gas units consumed by the mined transaction receipt.
  gasUsed       BigInt?
  jobId         String
  trainingJob   TrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  roundId       String?
  trainingRound TrainingJobRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@index([jobId])
  @@index([roundId])
  @@map("blockchain_transaction")
}

model ModelUpdate {
  id              String           @id @default(cuid())
  chainUpdateId   String?          @unique
  chainTxHash     String?
  chainSyncStatus ChainSyncStatus  @default(PENDING)
  trainingRoundId String
  trainingRound   TrainingJobRound @relation(fields: [trainingRoundId], references: [id], onDelete: Cascade)
  clientAddress   String
  score           String
  modelHash       String
  prevModelHash   String
  prevModel       Model            @relation("PreviousModelUpdate", fields: [prevModelHash], references: [hash], onDelete: SetNull)
  epoch           String
  learningRate    String
  batchSize       String
  accuracy        String
  metrics         Json?
  timestamp       DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([trainingRoundId, clientAddress])
  @@index([trainingRoundId])
  @@index([createdAt])
  @@map("model_update")
}

model TrainingJobLog {
  id        String      @id @default(cuid())
  jobId     String
  job       TrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String      @default("info")
  message   String
  createdAt DateTime    @default(now())

  @@index([jobId, createdAt])
  @@map("training_job_log")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
